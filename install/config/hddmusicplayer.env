# hddmusicplayer ayarları. Değişiklikten sonra:
#   sudo systemctl restart hddmusicplayer-api hddmusicplayer-panel

# --- Yollar ------------------------------------------------------------------
# MUSIC_ROOT, /etc/mpd.conf içindeki music_directory ile AYNI olmak zorunda.
HDDMUSICPLAYER_MUSIC_ROOT=@MUSIC_ROOT@
HDDMUSICPLAYER_DATA_DIR=/var/lib/hddmusicplayer

# --- Ağ ----------------------------------------------------------------------
HDDMUSICPLAYER_HTTP_HOST=0.0.0.0
HDDMUSICPLAYER_HTTP_PORT=8080
HDDMUSICPLAYER_MPD_HOST=127.0.0.1
HDDMUSICPLAYER_MPD_PORT=6600

# --- Ses ---------------------------------------------------------------------
# softvol : ses arayüzden ayarlanır (ALSA softvol)
# fixed   : DAC hep tam çıkış, seviye amfiden ayarlanır (bit-perfect)
# Bu değeri değiştirdikten sonra install.sh'ı VOLUME_MODE=... ile tekrar çalıştır,
# çünkü /etc/mpd.conf'un da buna göre üretilmesi gerekiyor.
HDDMUSICPLAYER_VOLUME_MODE=@VOLUME_MODE@

# --- Kütüphane ---------------------------------------------------------------
HDDMUSICPLAYER_SCAN_ON_START=1
HDDMUSICPLAYER_ART_THUMB_SIZE=320
HDDMUSICPLAYER_ART_FULL_SIZE=800

# --- Öneri motoru ------------------------------------------------------------
# Kuyrukta bu kadar parça kalınca otomatik doldurma devreye girer.
HDDMUSICPLAYER_AUTOQUEUE_MIN=5
HDDMUSICPLAYER_AUTOQUEUE_BATCH=15
# Akıllı karıştırmada aynı sanatçı/albüm arasındaki en az parça mesafesi.
HDDMUSICPLAYER_DIVERSITY_ARTIST_GAP=5
HDDMUSICPLAYER_DIVERSITY_ALBUM_GAP=8
# Bir parçanın "dinlendi" sayılması için gereken oran (altı "atlandı").
HDDMUSICPLAYER_PLAY_COMPLETION_RATIO=0.5

# --- Panel (3.5" ekran) ------------------------------------------------------
HDDMUSICPLAYER_PANEL_FB=/dev/fb1
HDDMUSICPLAYER_PANEL_WIDTH=480
HDDMUSICPLAYER_PANEL_HEIGHT=320
HDDMUSICPLAYER_PANEL_FPS=10
# Boş bırakılırsa dokunmatik aygıt otomatik bulunur.
HDDMUSICPLAYER_PANEL_TOUCH_DEVICE=

# --- EC11 döner encoder ------------------------------------------------------
# BCM pin numaraları. Varsayılanlar 26 pinlik ekranın altında kalmayan
# fiziksel pinlere denk gelir: 29, 31, 33.
HDDMUSICPLAYER_ENCODER_ENABLED=1
HDDMUSICPLAYER_ENCODER_PIN_A=5
HDDMUSICPLAYER_ENCODER_PIN_B=6
HDDMUSICPLAYER_ENCODER_PIN_SW=13
# Saat yönü sesi kısıyorsa bunu 1 yap.
HDDMUSICPLAYER_ENCODER_REVERSED=0
HDDMUSICPLAYER_ENCODER_VOLUME_STEP=2
HDDMUSICPLAYER_ENCODER_LONG_PRESS=0.6
