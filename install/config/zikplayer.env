# zikplayer ayarları. Değişiklikten sonra:
#   sudo systemctl restart zikplayer-api zikplayer-panel

# --- Yollar ------------------------------------------------------------------
# MUSIC_ROOT, /etc/mpd.conf içindeki music_directory ile AYNI olmak zorunda.
ZIK_MUSIC_ROOT=@MUSIC_ROOT@
ZIK_DATA_DIR=/var/lib/zikplayer

# --- Ağ ----------------------------------------------------------------------
ZIK_HTTP_HOST=0.0.0.0
ZIK_HTTP_PORT=8080
ZIK_MPD_HOST=127.0.0.1
ZIK_MPD_PORT=6600

# --- Ses ---------------------------------------------------------------------
# softvol : ses arayüzden ayarlanır (ALSA softvol)
# fixed   : DAC hep tam çıkış, seviye amfiden ayarlanır (bit-perfect)
# Bu değeri değiştirdikten sonra install.sh'ı VOLUME_MODE=... ile tekrar çalıştır,
# çünkü /etc/mpd.conf'un da buna göre üretilmesi gerekiyor.
ZIK_VOLUME_MODE=@VOLUME_MODE@

# --- Kütüphane ---------------------------------------------------------------
ZIK_SCAN_ON_START=1
ZIK_ART_THUMB_SIZE=320
ZIK_ART_FULL_SIZE=800

# --- Öneri motoru ------------------------------------------------------------
# Kuyrukta bu kadar parça kalınca otomatik doldurma devreye girer.
ZIK_AUTOQUEUE_MIN=5
ZIK_AUTOQUEUE_BATCH=15
# Akıllı karıştırmada aynı sanatçı/albüm arasındaki en az parça mesafesi.
ZIK_DIVERSITY_ARTIST_GAP=5
ZIK_DIVERSITY_ALBUM_GAP=8
# Bir parçanın "dinlendi" sayılması için gereken oran (altı "atlandı").
ZIK_PLAY_COMPLETION_RATIO=0.5

# --- Panel (3.5" ekran) ------------------------------------------------------
ZIK_PANEL_FB=/dev/fb1
ZIK_PANEL_WIDTH=480
ZIK_PANEL_HEIGHT=320
ZIK_PANEL_FPS=10
# Boş bırakılırsa dokunmatik aygıt otomatik bulunur.
ZIK_PANEL_TOUCH_DEVICE=

# --- EC11 döner encoder ------------------------------------------------------
# BCM pin numaraları. Varsayılanlar 26 pinlik ekranın altında kalmayan
# fiziksel pinlere denk gelir: 29, 31, 33.
ZIK_ENCODER_ENABLED=1
ZIK_ENCODER_PIN_A=5
ZIK_ENCODER_PIN_B=6
ZIK_ENCODER_PIN_SW=13
# Saat yönü sesi kısıyorsa bunu 1 yap.
ZIK_ENCODER_REVERSED=0
ZIK_ENCODER_VOLUME_STEP=2
ZIK_ENCODER_LONG_PRESS=0.6
