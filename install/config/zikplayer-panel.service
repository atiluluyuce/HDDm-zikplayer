[Unit]
Description=zikplayer 3.5" dokunmatik panel arayüzü
Documentation=https://github.com/atiluluyuce/HDDm-zikplayer
After=zikplayer-api.service
Wants=zikplayer-api.service

[Service]
Type=simple
User=@USER@
Group=@USER@
# Framebuffer, dokunmatik ve GPIO erişimi için ek gruplar.
SupplementaryGroups=video input gpio audio
WorkingDirectory=@REPO_DIR@/server
EnvironmentFile=/etc/zikplayer/zikplayer.env
Environment=PYTHONUNBUFFERED=1
Environment=ZIK_API_URL=http://127.0.0.1:8080
ExecStart=@VENV_DIR@/bin/python -m zikplayer.panel
Restart=always
RestartSec=5

# Panel, API'nin ayağa kalkmasını kendi içinde bekliyor (60 sn'ye kadar).
TimeoutStartSec=120

ProtectSystem=full
PrivateTmp=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
